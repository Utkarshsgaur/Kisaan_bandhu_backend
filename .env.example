# ============================================================
# Kisan Bandhu Backend — Environment Variables
# Copy this to .env or set these in your deployment platform
# ============================================================

# Server
SERVER_PORT=8080

# Database (Aiven MySQL) — REQUIRED, set these in your deployment platform or .env
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT — MUST be at least 32 characters, change before production!
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-characters-SIH
JWT_EXPIRATION_MS=3600000

# CORS — comma-separated list of allowed frontend origins
# For local dev:
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
# For production (update after Vercel deploy):
# FRONTEND_ORIGIN=https://kisan-bandhu.vercel.app

# OTP — set to true for SIH demo (OTP returned in response)
# Set to false in production and integrate an SMS provider
OTP_DEV_MODE=true

# Queue settings
AVG_PROCESSING_MINUTES=5
